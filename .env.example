# Settings are read from ENVIRONMENT VARIABLES (there is no .env loader on purpose).
# Every value below is optional; these are the defaults. Example in PowerShell:
#   $env:DOCS_DIR = "data_other_course"
# No API key is needed.

DOCS_DIR=data                  # folder with the PDFs; change it to index another course
INDEX_DIR=site/index           # where the index is saved (the web page reads it from here)
EMBED_MODEL=Xenova/multilingual-e5-small   # Hugging Face repo with the ONNX model files
